# Copy to .env for local runs. NEVER commit the real .env (it is gitignored).
# In GitHub these live in Settings -> Secrets and variables -> Actions.

# ---------------------------------------------------------------------------
# REQUIRED -- sending alerts
# Discord channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook.
# This alone is enough for the scanner to work.
# ---------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/replace-me

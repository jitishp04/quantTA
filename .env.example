# Copy to .env for local runs. NEVER commit the real .env (it is gitignored).
# In GitHub these live in Settings -> Secrets and variables -> Actions.

# ---------------------------------------------------------------------------
# REQUIRED -- sending alerts
# Discord channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook.
# This alone is enough for the scanner to work.
# ---------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/replace-me

# ---------------------------------------------------------------------------
# OPTIONAL -- receiving !add / !remove commands
# A webhook can only send, so reading the channel needs a bot. Leave these
# blank and alerts still work; you just manage tickers by editing
# config/tickers.txt directly.
#
# Requires MESSAGE CONTENT INTENT enabled at discord.com/developers
# -> your app -> Bot -> Privileged Gateway Intents. Without it every message
# arrives with empty content and commands are silently ignored.
# ---------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Optional hardening: restrict commands to a single Discord user id. Blank
# means anyone who can post in the channel can manage the watchlist.
DISCORD_USER_ID=
